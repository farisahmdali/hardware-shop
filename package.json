{
  "name": "hardware-shop",
  "productName": "Hardware Shop Manager",
  "version": "1.0.0",
  "description": "Offline sales, inventory, rental and accounts management for a hardware shop",
  "private": true,
  "main": "out/main/index.js",
  "author": "Hardware Shop Manager",
  "license": "UNLICENSED",
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node scripts/run-vitest.mjs run",
    "test:watch": "node scripts/run-vitest.mjs",
    "test:e2e": "npm run build && playwright test",
    "perf": "node scripts/run-vitest.mjs run --config vitest.perf.config.ts",
    "test:install": "npm run build && node scripts/build-test-installers.mjs && playwright test -c playwright.install.config.ts",
    "dist": "npm run build && electron-builder --win nsis && node scripts/check-package.mjs release/win-unpacked",
    "dist:mac": "npm run build && electron-builder --mac dmg --publish never",
    "icon": "electron scripts/make-icon.mjs"
  },
  "build": {
    "appId": "com.hardwareshop.manager",
    "productName": "Hardware Shop Manager",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!node_modules/better-sqlite3/{deps,src,build}/**/*"
    ],
    "electronLanguages": [
      "en-US",
      "en-GB"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Hardware Shop Manager"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.business"
    }
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "electron-log": "5.4.4",
    "exceljs": "4.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@hookform/resolvers": "5.9.1",
    "@playwright/test": "1.63.0",
    "@radix-ui/react-dialog": "1.2.0",
    "@radix-ui/react-dropdown-menu": "2.1.25",
    "@radix-ui/react-tabs": "1.1.22",
    "@radix-ui/react-tooltip": "1.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.104.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "clsx": "2.1.1",
    "electron": "44.6.0",
    "electron-builder": "26.17.0",
    "electron-vite": "5.0.0",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "react-router-dom": "7.18.4",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "7.3.7",
    "vitest": "5.0.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true,
    "electron@44.6.0": true,
    "better-sqlite3@13.0.3": true
  }
}
